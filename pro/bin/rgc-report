#!/usr/bin/env python3
"""Aggregate audit records and git history into an adoption picture."""

import argparse
import glob
import json
import os
import subprocess
import sys
from collections import defaultdict


def repo_root():
    out = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True, check=False)
    if out.returncode != 0:
        sys.exit("not inside a git repository")
    return out.stdout.strip()


def load_sessions(since):
    rows = []
    for path in sorted(glob.glob(
            os.path.join(repo_root(), ".rgc", "sessions", "*.jsonl"))):
        events = [json.loads(ln) for ln in open(path) if ln.strip()]
        start = next((e for e in events if e["event"] == "start"), None)
        if not start:
            continue
        if since and start["at"][:10] < since:
            continue
        kinds = [e["kind"] for e in events if e["event"] == "step"]
        rows.append({
            "author": start.get("author", "unknown"),
            "task": start.get("task", ""),
            "date": start["at"][:10],
            "red": kinds.count("red"),
            "green": kinds.count("green"),
            "move": kinds.count("move"),
            "waive": kinds.count("waive"),
            "closed": any(e["event"] == "close" for e in events),
        })
    return rows


def drift_summary(since):
    tool = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                        "rgc-drift")
    cmd = [sys.executable, tool, "--json"]
    cmd += ["--since", since] if since else ["-n", "200"]
    out = subprocess.run(cmd, capture_output=True, text=True, check=False)
    if out.returncode not in (0, 1) or not out.stdout.strip():
        return None
    try:
        return json.loads(out.stdout)
    except json.JSONDecodeError:
        return None


def main():
    ap = argparse.ArgumentParser(prog="rgc-report")
    ap.add_argument("--since", metavar="YYYY-MM-DD")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    sessions = load_sessions(args.since)
    drift = drift_summary(args.since)

    by_author = defaultdict(lambda: defaultdict(int))
    for s in sessions:
        a = by_author[s["author"]]
        a["sessions"] += 1
        a["red"] += s["red"]
        a["green"] += s["green"]
        a["move"] += s["move"]
        a["waive"] += s["waive"]
        a["test_first"] += 1 if s["red"] else 0

    if args.json:
        print(json.dumps({"sessions": sessions,
                          "by_author": {k: dict(v)
                                        for k, v in by_author.items()},
                          "drift": drift}, indent=2))
        return

    print(f"Sessions recorded: {len(sessions)}"
          + (f"  since {args.since}" if args.since else ""))
    if sessions:
        print()
        print(f"{'author':<34}{'sessions':>9}{'test-first':>12}"
              f"{'moves':>8}{'waived':>8}")
        for author, a in sorted(by_author.items()):
            rate = a["test_first"] / a["sessions"] * 100 if a["sessions"] else 0
            print(f"{author[:33]:<34}{a['sessions']:>9}"
                  f"{rate:>11.0f}%{a['move']:>8}{a['waive']:>8}")
        print()
        print("test-first = sessions where a failing test was recorded before")
        print("production code. It is a count of sessions, not of people.")
    else:
        print("No audit records yet. They appear once someone runs rgc-audit.")

    if drift:
        print()
        print(f"Git history over the same window: "
              f"{drift['problem_pct']:.0f}% problem commits "
              f"({drift['problem_commits']} of {drift['gradeable']})")
        print("Compare the two. A high test-first rate with a high problem")
        print("rate means the records say one thing and the commits another.")


if __name__ == "__main__":
    main()
