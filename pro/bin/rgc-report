#!/usr/bin/env python3
"""Team report: adoption, trend, defect correlation, coaching."""

import argparse
import glob
import json
import os
import sys
from collections import Counter, defaultdict

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from rgcdrift import PROBLEMS, VERDICTS, analyse, git  # noqa: E402
import rgcteam  # noqa: E402

RULE = "-" * 64


def repo_root():
    root = git("rev-parse", "--show-toplevel").strip()
    if not root:
        sys.exit("not inside a git repository")
    return root


def load_sessions(root, since):
    rows = []
    for path in sorted(glob.glob(
            os.path.join(root, ".rgc", "sessions", "*.jsonl"))):
        events = [json.loads(ln) for ln in open(path) if ln.strip()]
        start = next((e for e in events if e["event"] == "start"), None)
        if not start or (since and start["at"][:10] < since):
            continue
        kinds = [e["kind"] for e in events if e["event"] == "step"]
        rows.append({
            "author": start.get("author", "unknown"),
            "date": start["at"][:10],
            "red": kinds.count("red"),
            "waive": kinds.count("waive"),
            "move": kinds.count("move"),
        })
    return rows


def section(title):
    print()
    print(title)
    print(RULE)


def report_history(rows):
    graded = [r for r in rows if r["verdict"] != "scaffold"]
    problems = sum(1 for r in graded if r["verdict"] in PROBLEMS)
    pct = (problems / len(graded) * 100) if graded else 0.0
    counts = Counter(r["verdict"] for r in rows)

    section("HISTORY")
    print(f"{len(graded)} commits with code changes "
          f"({counts['scaffold']} scaffold, not graded)")
    for v, (label, meaning) in VERDICTS.items():
        if counts[v] and v != "scaffold":
            print(f"  {label.strip():<11} {counts[v]:>5}   {meaning}")
    print()
    print(f"Problem rate: {pct:.0f}%  ({problems} of {len(graded)})")
    return pct


def report_trend(rows):
    periods = rgcteam.trend(rows)
    if len(periods) < 2:
        return
    section("TREND")
    width = 34
    worst = max((p["pct"] for p in periods), default=1) or 1
    for p in periods:
        bar = "#" * max(1, round(p["pct"] / worst * width)) if p["pct"] else ""
        print(f"  {p['period']}  {p['pct']:>5.0f}%  "
              f"{p['problems']:>3}/{p['gradeable']:<4} {bar}")
    first, last = periods[0], periods[-1]
    direction = ("improving" if last["pct"] < first["pct"]
                 else "worsening" if last["pct"] > first["pct"] else "flat")
    print()
    print(f"  {first['period']} to {last['period']}: {direction} "
          f"({first['pct']:.0f}% -> {last['pct']:.0f}%)")
    print("  Short periods swing a lot. Read the direction, not the step.")


def report_correlation(root, rows):
    c = rgcteam.correlate(root, rows)
    section("DEFECT CORRELATION")
    if not c["fix_commits"]:
        print("  No commits in range look like fixes. Nothing to correlate.")
        return
    print(f"  {c['fix_commits']} fix commit(s); traced to "
          f"{c['origins_traced']} origin commit(s) inside the range")
    if not c["origins_traced"]:
        print("  Origins fall outside the range. Widen it with --since.")
        return
    print()
    for verdict, n in sorted(c["origin_verdicts"].items(),
                             key=lambda kv: -kv[1]):
        flag = "  <-- problem" if verdict in PROBLEMS else ""
        print(f"    {VERDICTS[verdict][0].strip():<11} {n:>4}{flag}")
    print()
    print(f"  Commits later fixed:  {c['origin_problem_rate']:.0f}% "
          "were problem commits")
    print(f"  All commits:          {c['base_rate']:.0f}% are problem commits")
    if c["lift"] is not None:
        if c["lift"] >= 1.3:
            print(f"  Lift: {c['lift']}x — commits that skipped discipline are "
                  "over-represented\n        among the ones that later needed "
                  "fixing.")
        elif c["lift"] <= 0.8:
            print(f"  Lift: {c['lift']}x — no link visible here. Say so "
                  "plainly.")
        else:
            print(f"  Lift: {c['lift']}x — no meaningful difference.")
    print()
    print("  How this is computed: commits whose message reads like a fix are")
    print("  traced with git blame to whatever last touched the lines they")
    print("  changed. Correlation only. Busy files attract both fixes and")
    print("  rushed commits, and a small sample moves this number a lot.")
    print(f"  Treat under ~30 traced origins as a hint, not a finding "
          f"(here: {c['origins_traced']}).")


def report_people(rows, sessions, amap):
    by_author = defaultdict(Counter)
    for r in rows:
        by_author[rgcteam.canonical_author(r["author"], amap)][r["verdict"]] += 1
    sess_by_author = defaultdict(list)
    for s in sessions:
        sess_by_author[rgcteam.canonical_author(s["author"], amap)].append(s)

    graded_of = lambda c: sum(n for v, n in c.items() if v != "scaffold")
    shown = {a: c for a, c in by_author.items()
             if graded_of(c) >= rgcteam.MIN_GRADED}
    too_few = {a: c for a, c in by_author.items()
               if 0 < graded_of(c) < rgcteam.MIN_GRADED}

    section("BY AUTHOR")
    print(f"  {'author':<28}{'graded':>8}{'problems':>10}{'rate':>7}"
          f"{'sessions':>10}")
    for author, counts in sorted(shown.items(),
                                 key=lambda kv: -graded_of(kv[1])):
        graded = graded_of(counts)
        probs = sum(counts[v] for v in PROBLEMS)
        n_sessions = len(sess_by_author.get(author, []))
        print(f"  {author[:27]:<28}{graded:>8}{probs:>10}"
              f"{probs / graded * 100:>6.0f}%{n_sessions:>10}")
    if too_few:
        print()
        print(f"  {len(too_few)} author(s) had fewer than "
              f"{rgcteam.MIN_GRADED} graded commits in this window and are not"
              f"\n  shown. A rate from three commits is noise, and printing it"
              f" next to\n  someone's name invites it to be read as a fact.")
    if not shown:
        print("  Nobody has enough commits in this window to show a rate.")
    print()
    if len(shown) > 1:
        print("  One person showing twice? Git identities differ. Map them in")
        print("  .rgc/authors.map as 'alias = Canonical Name', one per line.")
        print()
    print("  This measures commits, not people. Deadline pressure produces")
    print("  problem commits far more reliably than carelessness does. Use it")
    print("  to decide what to teach, never to rank anyone.")
    return by_author


def report_coaching(by_author):
    printed = False
    for author, counts in sorted(by_author.items()):
        advice = rgcteam.coaching(counts)
        if not advice:
            continue
        if not printed:
            section("WHAT TO TEACH")
            printed = True
        print(f"  {author}")
        for line in advice:
            print(f"    - {line}")
        print()
    if not printed:
        section("WHAT TO TEACH")
        print("  Nothing stands out. Leave it alone.")


def report_sessions(sessions):
    if not sessions:
        return
    section("RECORDED SESSIONS")
    by_author = defaultdict(lambda: Counter())
    for s in sessions:
        a = by_author[s["author"]]
        a["sessions"] += 1
        a["test_first"] += 1 if s["red"] else 0
        a["waive"] += s["waive"]
    for author, a in sorted(by_author.items()):
        rate = a["test_first"] / a["sessions"] * 100
        print(f"  {author[:33]:<34}{a['sessions']:>4} sessions"
              f"{rate:>7.0f}% test-first{a['waive']:>5} waived")
    print()
    print("  Compare this with HISTORY above. If the recorded test-first rate")
    print("  is high and the problem rate is also high, the records and the")
    print("  commits disagree, and the commits are the ones to believe.")


def main():
    ap = argparse.ArgumentParser(
        prog="rgc-report", description="Team report over git history.")
    ap.add_argument("--since", metavar="YYYY-MM-DD")
    ap.add_argument("--path", metavar="DIR")
    ap.add_argument("-n", "--limit", type=int, default=400)
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    root = repo_root()
    limit = None if args.since else args.limit
    rows = analyse(None, args.path, limit, args.since)
    if not rows:
        print("No commits in range.")
        return 0
    sessions = load_sessions(root, args.since)
    amap = rgcteam.load_author_map(root)

    if args.json:
        print(json.dumps({
            "counts": dict(Counter(r["verdict"] for r in rows)),
            "trend": rgcteam.trend(rows),
            "correlation": rgcteam.correlate(root, rows),
            "sessions": sessions,
        }, indent=2))
        return 0

    window = f"since {args.since}" if args.since else f"last {len(rows)} commits"
    print(f"RED GREEN CLEAN — team report ({window})")
    report_history(rows)
    report_trend(rows)
    report_correlation(root, rows)
    by_author = report_people(rows, sessions, amap)
    report_sessions(sessions)
    report_coaching(by_author)
    print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
