#!/usr/bin/env python3
"""Record what happened during a session, in order, as it happens."""

import argparse
import json
import os
import subprocess
import sys
import uuid
from datetime import datetime, timezone

KINDS = ("red", "green", "move", "note", "waive")


def repo_root():
    out = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True, check=False)
    if out.returncode != 0:
        sys.exit("not inside a git repository")
    return out.stdout.strip()


def session_dir():
    d = os.path.join(repo_root(), ".rgc", "sessions")
    os.makedirs(d, exist_ok=True)
    return d


def pointer_path():
    return os.path.join(repo_root(), ".rgc", "current")


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def git_value(*args, default=""):
    out = subprocess.run(["git", *args], capture_output=True, text=True,
                         check=False)
    return out.stdout.strip() if out.returncode == 0 else default


def append(record):
    path = open(pointer_path()).read().strip() if \
        os.path.exists(pointer_path()) else None
    if not path or not os.path.exists(path):
        sys.exit("no open session — run: rgc-audit start --task \"...\"")
    with open(path, "a") as fh:
        fh.write(json.dumps(record) + "\n")
    return path


def cmd_start(args):
    sid = f"{datetime.now().strftime('%Y%m%d-%H%M%S')}-{uuid.uuid4().hex[:6]}"
    path = os.path.join(session_dir(), f"{sid}.jsonl")
    with open(path, "w") as fh:
        fh.write(json.dumps({
            "event": "start", "at": now(), "session": sid,
            "task": args.task,
            "author": git_value("config", "user.email", default="unknown"),
            "branch": git_value("rev-parse", "--abbrev-ref", "HEAD"),
            "head": git_value("rev-parse", "HEAD"),
        }) + "\n")
    with open(pointer_path(), "w") as fh:
        fh.write(path)
    print(f"session {sid} open")


def cmd_step(args):
    append({"event": "step", "at": now(), "kind": args.kind,
            "ref": args.ref, "head": git_value("rev-parse", "HEAD")})
    print(f"{args.kind}: {args.ref}")


def cmd_close(args):
    path = append({"event": "close", "at": now(),
                   "head": git_value("rev-parse", "HEAD")})
    steps = [json.loads(ln) for ln in open(path) if ln.strip()]
    kinds = [s.get("kind") for s in steps if s["event"] == "step"]
    os.remove(pointer_path())
    print(f"session closed: {len(kinds)} steps "
          f"({kinds.count('red')} red, {kinds.count('green')} green, "
          f"{kinds.count('move')} moves, {kinds.count('waive')} waived)")
    print(path)


def cmd_show(args):
    p = pointer_path()
    if not os.path.exists(p):
        print("no open session")
        return
    path = open(p).read().strip()
    for line in open(path):
        r = json.loads(line)
        if r["event"] == "start":
            print(f"task: {r['task']}  [{r['branch']}]")
        elif r["event"] == "step":
            print(f"  {r['kind']:<6} {r['ref']}")


def main():
    ap = argparse.ArgumentParser(prog="rgc-audit")
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("start"); s.add_argument("--task", required=True)
    s.set_defaults(fn=cmd_start)

    s = sub.add_parser("step")
    s.add_argument("--kind", required=True, choices=KINDS)
    s.add_argument("--ref", required=True)
    s.set_defaults(fn=cmd_step)

    sub.add_parser("close").set_defaults(fn=cmd_close)
    sub.add_parser("show").set_defaults(fn=cmd_show)

    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
