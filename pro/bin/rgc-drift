#!/usr/bin/env python3
"""Report where test-first discipline slipped, by reading git history."""

import argparse
import json
import os
import re
import sys
from collections import Counter, defaultdict

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from rgcdrift import VERDICTS, PROBLEMS, analyse  # noqa: E402


def main():
    ap = argparse.ArgumentParser(
        prog="rgc-drift",
        description="Report where test-first discipline slipped.",
    )
    ap.add_argument("--since", metavar="REV",
                    help="revision range, e.g. origin/main..HEAD or a date")
    ap.add_argument("--path", metavar="DIR", help="limit to a subdirectory")
    ap.add_argument("-n", "--limit", type=int, default=50,
                    help="max commits (default 50; ignored with --since)")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--fail-over", type=float, metavar="PCT",
                    help="exit 1 if problem commits exceed this percentage")
    ap.add_argument("--quiet", action="store_true",
                    help="summary only, no per-commit lines")
    args = ap.parse_args()

    rev = args.since
    if rev and ".." not in rev and not re.match(r"^\d{4}-\d{2}", rev):
        rev = f"{rev}..HEAD"
    elif rev and re.match(r"^\d{4}-\d{2}", rev):
        rev = None
        extra_since = args.since
    else:
        extra_since = None

    limit = None if rev else args.limit
    rows = analyse(rev, args.path, limit, extra_since)

    if not rows:
        print("No commits in range.")
        return 0

    counts = Counter()
    by_author = defaultdict(Counter)
    for r in rows:
        counts[r["verdict"]] += 1
        by_author[r["author"]][r["verdict"]] += 1

    gradeable = sum(
        n for v, n in counts.items() if v not in ("scaffold",)
    )
    problems = sum(counts[v] for v in PROBLEMS)
    pct = (problems / gradeable * 100) if gradeable else 0.0

    if args.json:
        print(json.dumps({
            "commits": [
                {k: r[k] for k in
                 ("sha", "author", "date", "subject", "verdict", "why")}
                for r in rows
            ],
            "counts": dict(counts),
            "gradeable": gradeable,
            "problem_commits": problems,
            "problem_pct": round(pct, 1),
        }, indent=2))
    else:
        if not args.quiet:
            for r in rows:
                label = VERDICTS[r["verdict"]][0]
                mark = "!" if r["verdict"] in PROBLEMS else " "
                print(f"{mark} {label} {r['sha'][:8]}  {r['subject'][:58]}")
                if r["verdict"] in PROBLEMS:
                    print(f"              -> {r['why']}")
            print()
        print(f"{gradeable} commits with code changes "
              f"({counts['scaffold']} scaffold-only, not graded)")
        for v, (label, meaning) in VERDICTS.items():
            if counts[v] and v != "scaffold":
                print(f"  {label.strip():<11} {counts[v]:>4}   {meaning}")
        print()
        print(f"Problem rate: {pct:.0f}%  ({problems} of {gradeable})")
        if problems:
            print()
            print("The two that matter most:")
            if counts["unprotected"]:
                print(f"  {counts['unprotected']} commit(s) changed behaviour "
                      "with no test in the same commit.")
            if counts["mixed"]:
                print(f"  {counts['mixed']} commit(s) mixed moving code with "
                      "changing it — these are the unreviewable ones.")

    if args.fail_over is not None and pct > args.fail_over:
        print(f"\nFAIL: {pct:.0f}% exceeds threshold {args.fail_over:.0f}%",
              file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
